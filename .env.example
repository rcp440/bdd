# ==================================================
# ARCHIVO DE EJEMPLO: .env.example
# Copia este archivo como .env y actualiza los valores
# ==================================================

# ========== SQL SERVER ==========
# Host de SQL Server (localhost, IP, o nombre del servidor)
SQL_SERVER=localhost

# Puerto de SQL Server (por defecto: 1433)
SQL_PORT=1433

# Nombre de la base de datos
SQL_DATABASE=AsistenciaDB

# Usuario de SQL Server
# Opciones comunes: sa (administrador), tu usuario personalizado
SQL_USER=sa

# Contraseña de SQL Server
# ⚠️  IMPORTANTE: Usa una contraseña segura en producción
SQL_PASSWORD=TuPassword123

# Encriptar conexión (true/false)
# Usa true si tienes certificado SSL en SQL Server
SQL_ENCRYPT=false

# ========== SERVIDOR ==========
# Puerto en el que correrá la aplicación
PORT=3000

# ========== SEGURIDAD ==========
# Clave secreta para JWT (tokens)
# Usa una cadena aleatoria larga y segura
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion_2024

# ========== AMBIENTE ==========
# Valores: development, production, test
NODE_ENV=development

# ==================================================
# NOTAS DE INSTALACIÓN:
# ==================================================
#
# 1. Para Windows Authentication (si usas Windows):
#    SQL_USER=<tu_usuario>
#    SQL_PASSWORD=<tu_contraseña>
#
# 2. Para usuario SA (administrador):
#    SQL_USER=sa
#    SQL_PASSWORD=<contraseña_sa>
#
# 3. Si SQL Server está en otra máquina:
#    SQL_SERVER=192.168.1.100
#    SQL_PORT=1433
#
# 4. Para conexión con certificado SSL:
#    SQL_ENCRYPT=true
#    Asegúrate de que el certificado esté instalado
#
# ==================================================
